info (
	desc:   "话题分类"
	author: "刘飞华"
	email:  "1002219331@qq.com"
)

type (
	// 添加话题分类请求参数
	AddTopicCategoryReq {
		Name       string `json:"name"` //分类名称
		Icon       string `json:"icon"` //分类图标
		ShowStatus int32  `json:"showStatus,default=2"` //显示状态：0->不显示；1->显示
		Sort       int32  `json:"sort"` //排序
	}
	AddTopicCategoryResp {
		Code    string `json:"code"`
		Message string `json:"message"`
	}
	// 删除话题分类请求参数
	DeleteTopicCategoryReq {
		Ids []int64 `form:"ids"`
	}
	DeleteTopicCategoryResp {
		Code    string `json:"code"`
		Message string `json:"message"`
	}
	// 更新话题分类请求参数
	UpdateTopicCategoryReq {
		Id         int64  `json:"id"` //主键id
		Name       string `json:"name"` //分类名称
		Icon       string `json:"icon"` //分类图标
		ShowStatus int32  `json:"showStatus,default=2"` //显示状态：0->不显示；1->显示
		Sort       int32  `json:"sort"` //排序
	}
	UpdateTopicCategoryResp {
		Code    string `json:"code"`
		Message string `json:"message"`
	}
	// 更新话题分类状态请求参数
	UpdateTopicCategoryStatusReq {
		Ids        []int64 `json:"ids"` //主键id
		ShowStatus int32   `json:"showStatus,default=2"` //显示状态：0->不显示；1->显示
	}
	UpdateTopicCategoryStatusResp {
		Code    string `json:"code"`
		Message string `json:"message"`
	}
	// 查询话题分类详情请求参数
	QueryTopicCategoryDetailReq {
		Id int64 `form:"id"`
	}
	QueryTopicCategoryDetailData {
		Id           int64  `json:"id"` //主键id
		Name         string `json:"name"` //分类名称
		Icon         string `json:"icon"` //分类图标
		SubjectCount int32  `json:"subjectCount"` //专题数量
		ShowStatus   int32  `json:"showStatus"` //显示状态：0->不显示；1->显示
		Sort         int32  `json:"sort"` //排序
		CreateBy     string `json:"createBy"` //创建者
		CreateTime   string `json:"createTime"` //创建时间
		UpdateBy     string `json:"updateBy"` //更新者
		UpdateTime   string `json:"updateTime"` //更新时间
	}
	QueryTopicCategoryDetailResp {
		Code    string                       `json:"code"`
		Message string                       `json:"message"`
		Data    QueryTopicCategoryDetailData `json:"data"`
	}
	// 分页查询话题分类列表请求参数
	QueryTopicCategoryListReq {
		Current    int64  `form:"current,default=1"` //第几页
		PageSize   int64  `form:"pageSize,default=20"` //每页的数量
		Name       string `form:"name,optional"` //分类名称
		ShowStatus int32  `form:"showStatus,default=2"` //显示状态：0->不显示；1->显示
	}
	QueryTopicCategoryListData {
		Id           int64  `json:"id"` //主键id
		Name         string `json:"name"` //分类名称
		Icon         string `json:"icon"` //分类图标
		SubjectCount int32  `json:"subjectCount"` //专题数量
		ShowStatus   int32  `json:"showStatus"` //显示状态：0->不显示；1->显示
		Sort         int32  `json:"sort"` //排序
		CreateBy     string `json:"createBy"` //创建者
		CreateTime   string `json:"createTime"` //创建时间
		UpdateBy     string `json:"updateBy"` //更新者
		UpdateTime   string `json:"updateTime"` //更新时间
	}
	QueryTopicCategoryListResp {
		Code     string                        `json:"code"`
		Message  string                        `json:"message"`
		Current  int64                         `json:"current,default=1"`
		Data     []*QueryTopicCategoryListData `json:"data"`
		PageSize int64                         `json:"pageSize,default=20"`
		Success  bool                          `json:"success"`
		Total    int64                         `json:"total"`
	}
)

@server (
	jwt:        Auth
	middleware: CheckUrl
	group:      cms/topic_category
	prefix:     /api/cms/topicCategory
	tags:       "话题分类"
	authType:   apiKey
)
service admin-api {
	// 添加话题分类
	@handler AddTopicCategory
	post /addTopicCategory (AddTopicCategoryReq) returns (AddTopicCategoryResp)

	// 删除话题分类
	@handler DeleteTopicCategory
	get /deleteTopicCategory (DeleteTopicCategoryReq) returns (DeleteTopicCategoryResp)

	// 更新话题分类
	@handler UpdateTopicCategory
	post /updateTopicCategory (UpdateTopicCategoryReq) returns (UpdateTopicCategoryResp)

	// 更新话题分类状态
	@handler UpdateTopicCategoryStatus
	post /updateTopicCategoryStatus (UpdateTopicCategoryStatusReq) returns (UpdateTopicCategoryStatusResp)

	// 查询话题分类详情
	@handler QueryTopicCategoryDetail
	get /queryTopicCategoryDetail (QueryTopicCategoryDetailReq) returns (QueryTopicCategoryDetailResp)

	// 分页查询话题分类列表
	@handler QueryTopicCategoryList
	get /queryTopicCategoryList (QueryTopicCategoryListReq) returns (QueryTopicCategoryListResp)
}

