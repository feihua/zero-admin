import "../base/base.api"

info (
	desc:   "菜单信息"
	author: "liufeihua"
	email:  "1002219331@qq.com"
)

type (
	// 添加菜单信息
	AddMenuReq {
		MenuName     string `json:"menuName,optional"` //菜单名称
		MenuType     int32  `json:"menuType"` //菜单类型(1:目录,2:菜单,3:按钮)
		MenuUrl      string `json:"menuUrl,optional"` //路由路径
		MenuIcon     string `json:"menuIcon,optional"` //菜单图标
		MenuSort     int32  `json:"menuSort"` //排序
		ParentId     int64  `json:"parentId,default=0"` //父id
		ApiUrl       string `json:"apiUrl,optional"` //接口url
		Visible      int32  `json:"visible"` //显示状态（0:隐藏,显示:1）
		Status       int32  `json:"status,default=2"` //菜单状态(1:正常，0:禁用)
		Remark       string `json:"remark,optional"` //备注
		VuePath      string `json:"vuePath,optional"` //vue的path
		VueComponent string `json:"vueComponent,optional"` //vue的页面
		VueIcon      string `json:"vueIcon,optional"` //vue的图标
		VueRedirect  string `json:"vueRedirect,optional"` //vue的路由重定向
		AngularIcon  string `json:"angularIcon,optional"` //angular的图标
		ReactIcon    string `json:"reactIcon,optional"` //antd react的图标
	}
	// 删除菜单信息
	DeleteMenuReq {
		Ids []int64 `form:"ids"`
	}
	// 更新菜单信息
	UpdateMenuReq {
		Id           int64  `json:"id"` //主键
		MenuName     string `json:"menuName,optional"` //菜单名称
		MenuType     int32  `json:"menuType"` //菜单类型(1:目录,2:菜单,3:按钮)
		MenuUrl      string `json:"menuUrl,optional"` //路由路径
		MenuIcon     string `json:"menuIcon,optional"` //菜单图标
		MenuSort     int32  `json:"menuSort"` //排序
		ParentId     int64  `json:"parentId,default=0"` //父id
		ApiUrl       string `json:"apiUrl,optional"` //接口url
		Visible      int32  `json:"visible"` //显示状态（0:隐藏,显示:1）
		Status       int32  `json:"status,default=2"` //菜单状态(1:正常，0:禁用)
		Remark       string `json:"remark,optional"` //备注
		VuePath      string `json:"vuePath,optional"` //vue的path
		VueComponent string `json:"vueComponent,optional"` //vue的页面
		VueIcon      string `json:"vueIcon,optional"` //vue的图标
		VueRedirect  string `json:"vueRedirect,optional"` //vue的路由重定向
		AngularIcon  string `json:"angularIcon,optional"` //angular的图标
		ReactIcon    string `json:"reactIcon,optional"` //antd react的图标
	}
	// 批量更新菜单信息状态
	UpdateMenuStatusReq {
		MenuId     int64 `json:"menuId"` //编号
		MenuStatus int32 `json:"menuStatus"` //菜单状态
	}
	// 查询菜单信息详情
	QueryMenuDetailReq {
		Id int64 `form:"id"`
	}
	QueryMenuDetailData {
		Id           int64  `json:"id"` //主键
		MenuName     string `json:"menuName"` //菜单名称
		Ancestors    string `json:"ancestors"` //祖级列表
		MenuType     int32  `json:"menuType"` //菜单类型(1:目录,2:菜单,3:按钮)
		MenuUrl      string `json:"menuUrl"` //路由路径
		MenuIcon     string `json:"menuIcon"` //菜单图标
		MenuSort     int32  `json:"menuSort"` //排序
		ParentId     int64  `json:"parentId"` //父id
		ApiUrl       string `json:"apiUrl"` //接口url
		Visible      int32  `json:"visible"` //显示状态（0:隐藏,显示:1）
		Status       int32  `json:"status"` //菜单状态(1:正常，0:禁用)
		Remark       string `json:"remark"` //备注
		VuePath      string `json:"vuePath"` //vue的path
		VueComponent string `json:"vueComponent"` //vue的页面
		VueIcon      string `json:"vueIcon"` //vue的图标
		VueRedirect  string `json:"vueRedirect"` //vue的路由重定向
		AngularIcon  string `json:"angularIcon"` //angular的图标
		ReactIcon    string `json:"reactIcon"` //antd react的图标
		CreateBy     string `json:"createBy"` //创建者
		CreateTime   string `json:"createTime"` //创建时间
		UpdateBy     string `json:"updateBy"` //更新者
		UpdateTime   string `json:"updateTime"` //更新时间
	}
	QueryMenuDetailResp {
		Code    string              `json:"code"`
		Message string              `json:"message"`
		Data    QueryMenuDetailData `json:"data"`
	}
	// 分页查询菜单信息列
	QueryMenuListReq {
		Current    int64  `form:"current,default=1"` //第几页
		PageSize   int64  `form:"pageSize,default=20"` //每页的数量
		MenuName   string `form:"menuName,optional"` //菜单名称
		ParentId   int64  `form:"parentId,optional"` //父菜单ID
		MenuStatus int32  `form:"menuStatus,default=2"` //状态（0:关闭,1:正常 ）
	}
	QueryMenuListData {
		Id           int64  `json:"id"` //主键
		MenuName     string `json:"menuName"` //菜单名称
		Ancestors    string `json:"ancestors"` //祖级列表
		MenuType     int32  `json:"menuType"` //菜单类型(1:目录,2:菜单,3:按钮)
		MenuUrl      string `json:"menuUrl"` //路由路径
		MenuIcon     string `json:"menuIcon"` //菜单图标
		MenuSort     int32  `json:"menuSort"` //排序
		ParentId     int64  `json:"parentId"` //父id
		ApiUrl       string `json:"apiUrl"` //接口url
		Visible      int32  `json:"visible"` //显示状态（0:隐藏,显示:1）
		Status       int32  `json:"status"` //菜单状态(1:正常，0:禁用)
		Remark       string `json:"remark"` //备注
		VuePath      string `json:"vuePath"` //vue的path
		VueComponent string `json:"vueComponent"` //vue的页面
		VueIcon      string `json:"vueIcon"` //vue的图标
		VueRedirect  string `json:"vueRedirect"` //vue的路由重定向
		AngularIcon  string `json:"angularIcon"` //angular的图标
		ReactIcon    string `json:"reactIcon"` //antd react的图标
		CreateBy     string `json:"createBy"` //创建者
		CreateTime   string `json:"createTime"` //创建时间
		UpdateBy     string `json:"updateBy"` //更新者
		UpdateTime   string `json:"updateTime"` //更新时间
	}
	QueryMenuListResp {
		Code     string               `json:"code"`
		Message  string               `json:"message"`
		Current  int64                `json:"current,default=1"`
		Data     []*QueryMenuListData `json:"data"`
		PageSize int64                `json:"pageSize,default=20"`
		Success  bool                 `json:"success"`
		Total    int64                `json:"total"`
	}
)

@server (
	jwt:        Auth
	middleware: CheckUrl
	group:      sys/menu
	prefix:     /api/sys/menu
	tags:       "菜单管理"
	authType:   apiKey
)
service admin-api {
	// 添加菜单信息
	@handler AddMenu
	post /addMenu (AddMenuReq) returns (BaseResp)

	// 删除菜单信息
	@handler DeleteMenu
	get /deleteMenu (DeleteMenuReq) returns (BaseResp)

	// 更新菜单信息
	@handler UpdateMenu
	post /updateMenu (UpdateMenuReq) returns (BaseResp)

	// 批量更新菜单信息状态
	@handler UpdateMenuStatus
	post /updateMenuStatus (UpdateMenuStatusReq) returns (BaseResp)

	// 查询菜单信息详情
	@handler QueryMenuDetail
	get /queryMenuDetail (QueryMenuDetailReq) returns (QueryMenuDetailResp)

	// 分页查询菜单信息列表
	@handler QueryMenuList
	get /queryMenuList (QueryMenuListReq) returns (QueryMenuListResp)

	// 分页查询菜单信息列表
	@handler QueryMenuResourceList
	get /queryMenuResourceList (QueryMenuListReq) returns (QueryMenuListResp)
}

